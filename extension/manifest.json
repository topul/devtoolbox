{
  "manifest_version": 3,
  "name": "DevOps Toolbox",
  "short_name": "DevOps Toolbox",
  "description": "开发者与安全研究员的离线工具箱：编解码/格式化/加解密/HTTP 调试/AI 对话。",
  "version": "1.7.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "DevOps Toolbox",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
