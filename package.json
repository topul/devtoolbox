{
  "name": "devtoolbox",
  "private": false,
  "version": "1.10.0",
  "type": "module",
  "description": "DevOps Toolbox - a local toolkit for developers & security researchers (Electron + React) · 程序员与安全研究员的本地工具箱（Electron + React）",
  "author": {
    "name": "topul",
    "email": "qiaocuixinzhiweini@gmail.com"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:mcp && electron-vite dev",
    "dev:web": "vite",
    "build:app": "electron-vite build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build": "npm run build:app && npm run build:mcp",
    "build:web": "vite build",
    "build:ext": "vite build --config vite.config.extension.ts && node scripts/build-extension.mjs",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl",
    "release": "npm run build && electron-builder --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "i18n:check": "esbuild src/lib/locales/*.ts --outdir=node_modules/.cache/locales --format=esm --out-extension:.js=.mjs --log-level=error && node scripts/check-locale-parity.mjs node_modules/.cache/locales",
    "smoke": "node scripts/run-smoke.mjs",
    "smoke:assets": "node scripts/check-built-assets.mjs",
    "smoke:main": "node scripts/check-main-imports.mjs out/main/index.js out/preload/index.cjs",
    "smoke:ipc": "node scripts/check-ipc-channels.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:preload": "electron scripts/check-preload.mjs",
    "smoke:chat": "node scripts/run-smoke.mjs chat",
    "smoke:chatstore": "node scripts/run-smoke.mjs chatstore",
    "smoke:chatagent": "node scripts/run-smoke.mjs chatagent",
    "smoke:chattrace": "node scripts/run-smoke.mjs chattrace",
    "smoke:skills": "node scripts/run-smoke.mjs skills",
    "smoke:compare": "node scripts/run-smoke.mjs compare",
    "smoke:chatui": "node scripts/run-smoke.mjs chatui",
    "smoke:schema": "node scripts/run-smoke.mjs schema",
    "smoke:httpcodec": "node scripts/run-smoke.mjs httpcodec",
    "smoke:httpenv": "node scripts/run-smoke.mjs httpenv",
    "smoke:httpsnap": "node scripts/run-smoke.mjs httpsnap",
    "smoke:httpsave": "node scripts/run-smoke.mjs httpsave",
    "smoke:sse": "node scripts/run-smoke.mjs sse",
    "smoke:proxy": "node scripts/run-smoke.mjs proxy",
    "smoke:agentrules": "node scripts/run-smoke.mjs agentrules",
    "smoke:mcpprobe": "node scripts/run-smoke.mjs mcpprobe",
    "smoke:tracestore": "node scripts/run-smoke.mjs tracestore",
    "smoke:mcpclient": "node scripts/run-smoke.mjs mcpclient",
    "smoke:sqlcheck": "node scripts/run-smoke.mjs sqlcheck",
    "smoke:tls": "node scripts/run-smoke.mjs tls",
    "smoke:har": "node scripts/run-smoke.mjs har",
    "smoke:graphql": "node scripts/run-smoke.mjs graphql",
    "smoke:regexreplace": "node scripts/run-smoke.mjs regexreplace",
    "smoke:systemproxy": "node scripts/run-smoke.mjs systemproxy",
    "smoke:render": "node scripts/run-smoke.mjs render",
    "smoke:ux": "node scripts/run-smoke.mjs ux",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "shot": "electron scripts/shot.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.264",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ai": "^7.0.129",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.9",
    "jsqr": "^1.4.0",
    "minimatch": "^10.2.6",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.20.3",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.4.49",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.bugbucket.devtoolbox",
    "productName": "DevOps Toolbox",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/mcp/**",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "extraResources": [
      {
        "from": "out/mcp",
        "to": "mcp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "topul",
        "repo": "devtoolbox",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "msi": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "DevOps Toolbox"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "buildUniversalInstaller": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevOps Toolbox"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}",
      "buildUniversalInstaller": false
    }
  }
}
