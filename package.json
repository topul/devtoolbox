{
  "name": "devtoolbox",
  "private": false,
  "version": "1.4.0",
  "type": "module",
  "description": "DevOps Toolbox - \u7a0b\u5e8f\u5458\u4e0e\u5b89\u5168\u7814\u7a76\u5458\u7684\u672c\u5730\u5de5\u5177\u7bb1",
  "author": {
    "name": "topul",
    "email": "qiaocuixinzhiweini@gmail.com"
  },
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run build:mcp && electron-vite dev",
    "dev:web": "vite",
    "build:app": "electron-vite build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build": "npm run build:app && npm run build:mcp",
    "build:web": "vite build",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl",
    "release": "npm run build && electron-builder --publish never",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck": "tsc --noEmit",
    "i18n:check": "esbuild src/lib/locales/*.ts --outdir=node_modules/.cache/locales --format=esm --out-extension:.js=.mjs --log-level=error && node scripts/check-locale-parity.mjs node_modules/.cache/locales",
    "smoke:assets": "node scripts/check-built-assets.mjs",
    "smoke:main": "node scripts/check-main-imports.mjs out/main/index.js out/preload/index.cjs",
    "smoke:ipc": "node scripts/check-ipc-channels.mjs",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "smoke:mcpclient": "esbuild scripts/smoke-mcpclient.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-mcpclient.mjs --log-level=error && node node_modules/.cache/smoke-mcpclient.mjs",
    "smoke:chat": "esbuild scripts/smoke-chat.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-chat.mjs --log-level=error && node node_modules/.cache/smoke-chat.mjs",
    "smoke:chatstore": "esbuild scripts/smoke-chatstore.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-chatstore.mjs --log-level=error && node node_modules/.cache/smoke-chatstore.mjs",
    "smoke:schema": "esbuild scripts/smoke-schema.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-schema.mjs --log-level=error && node node_modules/.cache/smoke-schema.mjs",
    "smoke:agentrules": "esbuild scripts/smoke-agentrules.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-agentrules.mjs --log-level=error && node node_modules/.cache/smoke-agentrules.mjs",
    "smoke:chatagent": "esbuild scripts/smoke-chatagent.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-chatagent.mjs --log-level=error && node node_modules/.cache/smoke-chatagent.mjs",
    "smoke:preload": "electron scripts/check-preload.mjs",
    "shot": "electron scripts/shot.mjs",
    "smoke:render": "esbuild scripts/smoke-render.tsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --loader:.tsx=tsx --jsx=automatic --log-level=error --external:qrcode --external:react --external:react-dom --external:react/jsx-runtime && node node_modules/.cache/smoke.mjs",
    "smoke:proxy": "esbuild scripts/smoke-proxy.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-proxy.mjs --log-level=error --external:node-forge && node node_modules/.cache/smoke-proxy.mjs",
    "smoke:systemproxy": "esbuild scripts/check-systemproxy.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/check-systemproxy.mjs --log-level=error && node node_modules/.cache/check-systemproxy.mjs",
    "smoke:chatui": "esbuild scripts/smoke-chatui.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke-chatui.mjs --log-level=error --loader:.tsx=tsx --jsx=automatic --external:react --external:react-dom --external:react/jsx-runtime && node node_modules/.cache/smoke-chatui.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^2.0.264",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ai": "^5.0.261",
    "crypto-js": "^4.2.0",
    "electron-updater": "^6.8.9",
    "node-forge": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.20.3",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  },
  "build": {
    "appId": "com.bugbucket.devtoolbox",
    "productName": "DevOps Toolbox",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!out/mcp/**",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "extraResources": [
      {
        "from": "out/mcp",
        "to": "mcp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "topul",
        "repo": "devtoolbox",
        "releaseType": "draft"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "msi": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "DevOps Toolbox"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "buildUniversalInstaller": false,
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DevOps Toolbox"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}",
      "buildUniversalInstaller": false
    }
  }
}
